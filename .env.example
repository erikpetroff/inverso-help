# Leave NEXT_PUBLIC_SANITY_PROJECT_ID empty to run on the bundled content/seed.json.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Public URL of the deployed site (canonical links, sitemap).
NEXT_PUBLIC_SITE_URL=https://help.inverso.bg

# Editor token, only needed for `npm run seed` (Sanity → API → Tokens, "Editor").
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity webhook that calls POST /api/revalidate.
SANITY_REVALIDATE_SECRET=
