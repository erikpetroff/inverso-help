{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "app/**",
              "data/**",
              "deck-stage.js",
              "design-canvas.jsx",
              "design_handoff_feature_adoption/app/**",
              "design_handoff_feature_adoption/data/**",
              "doc-page.js",
              "export/**",
              "image-slot.js",
              "ios-frame.jsx",
              "logo-variants/**",
              "mobile/**",
              "ui_kits/dashboard/**",
              "ui_kits/invoice/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Inter, Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|qty|amount|key|ref|className|style|children)$/]",
        "message": "<DataTableRow> doesn't accept that prop. Declared props: name, price, qty, amount."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onSelect|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: active, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|delta|tone|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, delta, tone, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|purple|white)$/]",
        "message": "<StatTile> tone must be one of 'blue' | 'purple' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:crumb|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: crumb."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "DataTableRow": {
        "replaces": []
